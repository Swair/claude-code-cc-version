CompileFlags:
  Add:
    - "-I${HOME}/project/prosophor/main_src"
    - "-I${HOME}/project/prosophor/main_src/prosophor_core"
    - "-I${HOME}/project/prosophor/main_src/SYSTEM"
    - "-I${HOME}/project/prosophor/thirdparty_src/nlohmann_json-src/include"
    - "-I${HOME}/project/prosophor/thirdparty_src/spdlog-src/include"
    - "-I${HOME}/project/prosophor/thirdparty_src/llamacpp-src"
    - "-I${HOME}/project/prosophor/thirdparty_src/llamacpp-src/common"
    - "-I${HOME}/project/prosophor/thirdparty_src/llamacpp-src/ggml/include"
  Remove:
    - "-Werror"
